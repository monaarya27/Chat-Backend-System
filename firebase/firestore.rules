rules_version = '2';

// All reads/writes go through the backend, which uses the Firebase Admin SDK.
// The Admin SDK bypasses security rules, so we deny ALL direct client access.
// If you later let mobile/web clients read Firestore directly (e.g. for real-time
// listeners), replace this with membership-based rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
