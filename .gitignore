# Dependencies and build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# Environment files (secrets). Only the template is committed.
.env
.env.*
!.env.example

# Firebase service-account keys must never be committed, wherever they are saved
*service-account*.json
*-firebase-adminsdk-*.json

# Firebase emulator / CLI artifacts
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log
emulator-data/

# Logs
logs/
*.log
npm-debug.log*

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
