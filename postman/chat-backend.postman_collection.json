{
  "info": {
    "name": "Chat Backend System",
    "description": "All endpoints of the chat backend. Run requests top to bottom: later requests reuse {{chatId}} and {{messageId}} captured automatically by earlier ones.\n\nAUTH_MODE=dev: identity is sent in the X-User-Id header (set per request).\nAUTH_MODE=firebase: replace X-User-Id with `Authorization: Bearer <Firebase ID token>`.\n\nRun `npm run db:seed` first to create user1, user2, user3.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "userA", "value": "user1" },
    { "key": "userB", "value": "user2" },
    { "key": "outsider", "value": "user3" },
    { "key": "chatId", "value": "" },
    { "key": "messageId", "value": "" },
    { "key": "nextCursor", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" }
        },
        {
          "name": "Readiness (pings PostgreSQL + Firestore)",
          "request": { "method": "GET", "url": "{{baseUrl}}/health/ready" }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Register current user (optional; seed already creates user1-3)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "user4" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Dave Brown\",\n  \"email\": \"dave@example.com\"\n}" },
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Get user",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{userA}}" }],
            "url": "{{baseUrl}}/users/{{userB}}"
          }
        }
      ]
    },
    {
      "name": "API 1 - Create or get chat",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200 or 201', () => pm.expect([200, 201]).to.include(pm.response.code));",
              "const body = pm.response.json();",
              "if (body.chatId) pm.collectionVariables.set('chatId', body.chatId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-Id", "value": "{{userA}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"userAId\": \"{{userA}}\",\n  \"userBId\": \"{{userB}}\"\n}" },
        "url": "{{baseUrl}}/chat/create"
      }
    },
    {
      "name": "API 2 - Send message",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "if (body.message) pm.collectionVariables.set('messageId', body.message.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-Id", "value": "{{userA}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"senderId\": \"{{userA}}\",\n  \"text\": \"Hello!\"\n}" },
        "url": "{{baseUrl}}/chat/{{chatId}}/message/send"
      }
    },
    {
      "name": "API 3 - Get messages (first page)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('nextCursor', pm.response.json().pagination.nextCursor || '');"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "X-User-Id", "value": "{{userB}}" }],
        "url": {
          "raw": "{{baseUrl}}/chat/{{chatId}}/messages?limit=50",
          "host": ["{{baseUrl}}"],
          "path": ["chat", "{{chatId}}", "messages"],
          "query": [{ "key": "limit", "value": "50" }]
        }
      }
    },
    {
      "name": "API 3 - Get messages (next page via cursor)",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-User-Id", "value": "{{userB}}" }],
        "url": {
          "raw": "{{baseUrl}}/chat/{{chatId}}/messages?limit=50&cursor={{nextCursor}}",
          "host": ["{{baseUrl}}"],
          "path": ["chat", "{{chatId}}", "messages"],
          "query": [
            { "key": "limit", "value": "50" },
            { "key": "cursor", "value": "{{nextCursor}}" }
          ]
        }
      }
    },
    {
      "name": "API 4 - Mark message as read",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-Id", "value": "{{userB}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{userB}}\"\n}" },
        "url": "{{baseUrl}}/chat/{{chatId}}/message/{{messageId}}/read"
      }
    },
    {
      "name": "API 5 - Update last seen",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-Id", "value": "{{userB}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{userB}}\",\n  \"messageId\": \"{{messageId}}\"\n}" },
        "url": "{{baseUrl}}/chat/{{chatId}}/lastseen"
      }
    },
    {
      "name": "Get last seen of all members",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-User-Id", "value": "{{userA}}" }],
        "url": "{{baseUrl}}/chat/{{chatId}}/lastseen"
      }
    },
    {
      "name": "API 6 - List user chats",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-User-Id", "value": "{{userA}}" }],
        "url": "{{baseUrl}}/user/{{userA}}/chats"
      }
    },
    {
      "name": "Negative cases",
      "item": [
        {
          "name": "Send as non-member (403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{outsider}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"senderId\": \"{{outsider}}\",\n  \"text\": \"I should not be here\"\n}" },
            "url": "{{baseUrl}}/chat/{{chatId}}/message/send"
          }
        },
        {
          "name": "Create chat with unknown user (404)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userA}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"userAId\": \"{{userA}}\",\n  \"userBId\": \"ghost\"\n}" },
            "url": "{{baseUrl}}/chat/create"
          }
        },
        {
          "name": "Missing text (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userA}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"senderId\": \"{{userA}}\"\n}" },
            "url": "{{baseUrl}}/chat/{{chatId}}/message/send"
          }
        },
        {
          "name": "No identity header (401)",
          "request": { "method": "GET", "url": "{{baseUrl}}/user/{{userA}}/chats" }
        }
      ]
    }
  ]
}
