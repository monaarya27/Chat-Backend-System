# ---------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` or service-account JSON files.
# ---------------------------------------------------------------

# development | test | production
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---------- PostgreSQL (used by Prisma) ----------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://chat_user:change_me@localhost:5432/chat_backend?schema=public"

# ---------- Firebase / Firestore (OPTIONAL in development) ----------
# Leave all of these unset to keep messages IN MEMORY (lost on restart).
# Required when NODE_ENV=production or AUTH_MODE=firebase.
# FIREBASE_PROJECT_ID=your-firebase-project-id

# Option A (recommended locally): path to the service-account JSON you downloaded
# from Firebase Console > Project settings > Service accounts.
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase/service-account.json

# Option B (good for containers/CI): paste the fields directly.
# Keep the \n sequences in the private key; the app converts them to real newlines.
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option C: use the local Firestore emulator instead of a real project
# (no credentials needed). Start it with `npm run emulators`.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---------- Authentication ----------
# dev      -> identity is taken from the `X-User-Id` header (LOCAL DEVELOPMENT ONLY;
#             refused when NODE_ENV=production)
# firebase -> `Authorization: Bearer <Firebase ID token>`; the token's uid is the user id
AUTH_MODE=dev

# ---------- Only needed if you use docker-compose.yml for PostgreSQL ----------
# POSTGRES_PASSWORD=change_me
